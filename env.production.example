# ============================================================
#  رسين — إعدادات الإنتاج (انسخه إلى .env على السيرفر)
#  بعد التعبئة نفّذ:  php artisan key:generate --force
# ============================================================

APP_NAME="رسين - متابعة المشاريع"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh

# ضع دومينك الحقيقي (مع https بعد تفعيل الشهادة)
APP_URL=https://erp.rasin.sa

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ===== قاعدة البيانات (MySQL على نفس السيرفر) =====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rasin_projects
DB_USERNAME=rasin_user
DB_PASSWORD=

# ===== الجلسات/الكاش/الطابور =====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# ===== البريد (اضبطه لاحقاً لإرسال الإشعارات) =====
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@rasin.sa"
MAIL_FROM_NAME="${APP_NAME}"

# ===== مستخدم المدير الأول (يُستخدم مرة واحدة مع ProductionSeeder) =====
ADMIN_NAME="مدير النظام"
ADMIN_EMAIL=admin@rasin.sa
ADMIN_PASSWORD=
