APP_NAME="رسين - متابعة المشاريع"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=daily
LOG_LEVEL=info

# ===== قاعدة البيانات =====
# للتطوير المحلي السريع استخدم sqlite:
# DB_CONNECTION=sqlite
#
# للإنتاج على cPanel استخدم mysql:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rasin_projects
DB_USERNAME=amalak_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@amalak.sa"
MAIL_FROM_NAME="${APP_NAME}"
